<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.personal_loan.mapper.LoanOptionMapper">
    <update id="update" parameterType="com.example.personal_loan.entity.LoanOption">
        UPDATE loan_options
        <set>
            <if test="loanAmount != null">
                loan_amount = #{loanAmount},
            </if>
            <if test="interestRate != null">
                interest_rate = #{interestRate},
            </if>
            <if test="loanPeriod != null">
                loan_period = #{loanPeriod},
            </if>
            <if test="repaidType != null and repaidType != ''">
                repaid_type = #{repaidType},
            </if>
        </set>
        WHERE id = #{id}
        AND product_id = #{productId}
    </update>
</mapper>