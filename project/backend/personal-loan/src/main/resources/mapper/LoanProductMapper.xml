<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.personal_loan.mapper.LoanProductMapper">
    <select id="findByProductNameLike" resultType="com.example.personal_loan.entity.LoanProduct">
        SELECT *
        FROM loan_products
        WHERE product_name LIKE CONCAT('%', #{productName}, '%')
    </select>
</mapper>