<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.personal_loan.mapper.OrderMapper">

    <resultMap id="UserOrderListResultMap" type="com.example.personal_loan.dto.UserOrderListResponse">
        <id property="id" column="id"/>
        <result property="loanAmount" column="loan_amount"/>
        <result property="status" column="status"/>
        <result property="startTime" column="start_time"/>
        <result property="term" column="term"/>
        <result property="currentTerm" column="current_term"/>
        <result property="overdueDays" column="overdue_days"/>
    </resultMap>

    <select id="selectOrderListByUserId" resultMap="UserOrderListResultMap">
        SELECT
            id,
            loan_amount,
            status,
            start_time,
            term,
            current_term,
            overdue_days
        FROM orders
        WHERE user_id = #{userId}
        ORDER BY start_time DESC
    </select>

</mapper>