<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.personal_loan.mapper.WorkCertMapper">

    <!-- 动态更新非空字段 -->
    <update id="update" parameterType="com.example.personal_loan.entity.WorkCert">
        UPDATE work_cert
        <set>
            <if test="employmentCertPath != null">
                employment_cert_path = #{employmentCertPath},
            </if>
            <if test="salaryCertPath != null">
                salary_cert_path = #{salaryCertPath},
            </if>
        </set>
        WHERE work_cert_id = #{workCertId}
    </update>

</mapper>
