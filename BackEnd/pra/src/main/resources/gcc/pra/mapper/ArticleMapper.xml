<?xml version="1.0" encoding="UTF-8"?>
<!-- 声明 -->
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd"
>
<!-- sql动态语句 -->
<mapper namespace="gcc.pra.mapper.ArticleMapper">
    <select id="list" resultType="gcc.pra.pojo.Article">
        select * from article
        <where>
            <if test="categoryId!=null">
                category_id = #{categoryId}
            </if>
            <if test="state!=null">
                and state = #{state}
            </if>

        and create_user = #{id}
        </where>
    </select>
</mapper>