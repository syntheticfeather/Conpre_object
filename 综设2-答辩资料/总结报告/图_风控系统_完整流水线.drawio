        <mxCell id="v_85" value="Java 后端 (MlTrainingLogServiceImpl)&#xa;&#xa;1. 读取 feature_config.py Schema&#xa;2. 从6张业务表聚合 54维特征&#xa;3. 构造 JSON 请求 / XGBoost4j 本地推理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;fontSize=8;" parent="1" vertex="1">
