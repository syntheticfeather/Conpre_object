          <mxGeometry x="310" y="150" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_11" value="MongoDB 短期记忆&#xa;chat_history collection&#xa;&#xa;原始对话流水&#xa;按 session_id + 时间排序&#xa;最近 2 轮对话" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFF8E1;strokeColor=#E65100;" parent="1" vertex="1">
          <mxGeometry x="310" y="220" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_12" value="对 话 前: 多信号检索 + 记忆注入" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;" parent="1" vertex="1">
          <mxGeometry x="550" y="45" width="280" height="18" as="geometry" />
        </mxCell>
        <mxCell id="v_13" value="用户新消息&#xa;&quot;帮我算一下月供&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;" parent="1" vertex="1">
          <mxGeometry x="550" y="68" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v_14" value="UserMemoryStore.search()&#xa;多信号综合评分:&#xa;  vector_similarity x 0.50&#xa;+ importance         x 0.20&#xa;+ time_decay          x 0.15&#xa;+ entity_match        x 0.15&#xa;&#xa;过滤: valid_until &lt; now (过期)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#E3F2FD;" parent="1" vertex="1">
          <mxGeometry x="550" y="130" width="220" height="75" as="geometry" />
