          <mxGeometry x="550" y="220" width="250" height="18" as="geometry" />
        </mxCell>
        <mxCell id="v_17" value="time_decay = e^(-lambda * t)    lambda = ln(2)/90" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;" parent="1" vertex="1">
          <mxGeometry x="550" y="238" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v_18" value="entity_match:&#xa;query 实体 &quot;等额本息&quot; 命中记忆实体&#xa;-&gt; overlap/min(len) -&gt; 0~1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;" parent="1" vertex="1">
          <mxGeometry x="550" y="273" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_19" value="Zep 冲突检测&#xa;同 user_id + key 旧记忆&#xa;-&gt; valid_until = now (过期)&#xa;写入新记忆 (1年有效)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;" parent="1" vertex="1">
          <mxGeometry x="310" y="290" width="180" height="55" as="geometry" />
        </mxCell>
