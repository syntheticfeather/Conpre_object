        </mxCell>
        <mxCell id="v_8" value="UserMemoryStore&#xa;ChromaDB collection&#xa;&quot;user_memory&quot;&#xa;&#xa;metadata: user_id, type, key,&#xa;entities, importance, created_at,&#xa;valid_until (默认1年)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E8F5E9;strokeColor=#1B5E20;" parent="1" vertex="1">
