# 复制为 .env 后填入你的 Key（.env 已被 gitignore）
#
# 文本 LLM（DeepSeek 官方 OpenAI 兼容接口）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 可选：DeepSeek 思考模式。不需要时留空或删除
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high

# 视觉模型（读图转录材料）
# 与文本共用同一个 Key 时，VLM_API_KEY 可以留空，会自动复用 LLM_API_KEY
VLM_API_KEY=
VLM_BASE_URL=https://api.deepseek.com
VLM_MODEL=deepseek-flash

# 在线服务（本地演示 Key 为 classroom-demo-key；生产务必替换）
# 生产环境把 RISK_DOC_BASE_DIR 改为 ./uploads
RISK_API_KEY=classroom-demo-key
RISK_DOC_BASE_DIR=data/llm_features/source_docs
RISK_REQUEST_TIMEOUT=30
RISK_MAX_WORKERS=4
RISK_REDACT_PII=true
# LLM 特征值缓存（在线服务）；设为空字符串可关闭
RISK_FEATURE_CACHE_PATH=.cache/risk_features.json
